FROM ubuntu:noble

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libcurl4t64 \
    libssl3t64 \
    liblzma5 \
    libsnappy1v5 \
    libunwind8 \
    libyaml-cpp0.8 \
    libldap2 \
    unzip \
    file \
    && rm -rf /var/lib/apt/lists/*

COPY noble-nehalem-mongodb-upload/mongod.zip /tmp/mongod.zip

RUN set -eux; \
    echo "=== ZIP contents ==="; \
    unzip -l /tmp/mongod.zip; \
    echo "=== Extracting mongod ==="; \
    unzip -p /tmp/mongod.zip mongod > /usr/local/bin/mongod; \
    ls -lh /usr/local/bin/mongod; \
    chmod 0755 /usr/local/bin/mongod; \
    echo "=== Binary type ==="; \
    file /usr/local/bin/mongod; \
    echo "=== Shared library dependencies ==="; \
    ldd /usr/local/bin/mongod || true; \
    echo "=== UID 999 ==="; \
    getent passwd 999 || true; \
    echo "=== Creating mongodb user ==="; \
    useradd --system --uid 999 --home-dir /data/db mongodb; \
    mkdir -p /data/db; \
    chown -R mongodb:mongodb /data/db

VOLUME ["/data/db"]
EXPOSE 27017

USER mongodb
ENTRYPOINT ["/usr/local/bin/mongod"]
CMD ["--bind_ip_all", "--dbpath", "/data/db"]
